# Copy this file to ".env" and fill in your real key. Never commit .env.
# Get a key at https://api-manager.opentransportdata.swiss/
OJP_API_KEY=your-key-here
# Separate key for the OJP Fare API (product "OJP Fare")
OJP_FARE_API_KEY=your-key-here
# Shared secret between our trip engine and the Vertt API (any long random text)
VERTT_API_SECRET=your-secret-here
